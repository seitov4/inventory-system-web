NODE_ENV=development
PORT=5000
SKIP_AUTH=true

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=postgres_password_here
DB_SSL=false

JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# Public URL where users open the app served by the backend container/server.
FRONTEND_URL=http://localhost:5000

# Optional comma-separated origins for frontend dev servers or LAN testing.
# Example:
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.10:3000,http://192.168.1.10:5000,https://*.ngrok-free.dev
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,https://*.ngrok-free.dev
