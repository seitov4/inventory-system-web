NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:postgres_password_here@localhost:5432/inventory_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=postgres_password_here
DB_SSL=false

JWT_SECRET=replace-with-local-dev-secret
JWT_EXPIRES_IN=7d
PLATFORM_JWT_SECRET=
PLATFORM_JWT_EXPIRES_IN=12h
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,https://*.ngrok-free.dev

PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-this-password
PLATFORM_ADMIN_NAME=Platform Super Admin
